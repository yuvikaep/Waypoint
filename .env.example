SANDBOX_API_KEY=
SANDBOX_API_SECRET=
EWB_USERNAME=
EWB_PASSWORD=
EWB_GSTIN=
# Sandbox.co.in is a provider name; its api host is not automatically a test environment.
EWB_ENABLE_GENERATION=false

# Vercel serverless runtime. Configure in Vercel, not frontend VITE_* variables.
# DATABASE_URL=provided-by-vercel-storage-neon
# BLOB_READ_WRITE_TOKEN=provided-by-private-vercel-blob
# WAYPOINT_SESSION_SECRET=random-secret-at-least-24-characters
# GPS_GATEWAY_SECRET=shared-only-with-oracle-forwarder
# GPS_COMMAND_URL=https://92.4.84.227.sslip.io/gps-command
# GPS_TRACKER_PUBLIC_HOST=92.4.84.227
# WAYPOINT_ADMIN_EMAIL=admin@example.com
# WAYPOINT_ADMIN_PASSWORD=bootstrap-password-at-least-12-characters
# Oracle forwarder only:
# WAYPOINT_CLOUD_URL=https://waypoint-eta-pied.vercel.app

# GPS API. Omit GPS_ADMIN_TOKEN to create a private random local key on first run.
# GPS_ADMIN_TOKEN=use-a-random-secret-at-least-24-characters
GPS_HOST=127.0.0.1
GPS_PORT=5180
# Set this to the browser origin when using a reverse proxy, e.g. https://fleet.example.com
# GPS_PUBLIC_ORIGIN=https://fleet.example.com
# Existing Traccar server (or run npm run gateway:setup for a new local instance).
# TRACCAR_URL=http://127.0.0.1:8082
# TRACCAR_TOKEN=your-traccar-account-token
# Use 0.0.0.0 on a secured gateway host to accept SIM-connected hardware.
GPS_TRACKER_BIND=127.0.0.1
# Leave disabled until an installer verifies a starter-only relay on a parked test vehicle.
GPS_RELAY_ENABLED=false
