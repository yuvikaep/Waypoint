<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>
  <entry key='database.driver'>org.h2.Driver</entry>
  <entry key='database.url'>jdbc:h2:./data/database</entry>
  <entry key='database.user'>sa</entry>
  <entry key='database.password' />
  <entry key='protocols.enable'>gt06,teltonika</entry>
  <entry key='web.address'>127.0.0.1</entry>
  <entry key='database.maxPoolSize'>2</entry>
  <entry key='server.nettyThreads'>2</entry>
  <!-- Longer than the tracker's three-minute heartbeat, but not an indefinitely stale session. -->
  <entry key='gt06.timeout'>300</entry>
  <!-- Concox trackers with the extended Login (a PT06 sends a 17-byte one carrying its time zone and
       language) expect commands to carry a language field too. Without it the 0x80 command goes out,
       the tracker never answers and resets the connection within seconds. -->
  <entry key='gt06.language'>true</entry>
  <!-- Push every position and event to the local gateway worker so it syncs within about a second. -->
  <entry key='forward.type'>json</entry>
  <entry key='forward.url'>http://127.0.0.1:8183/position</entry>
  <entry key='event.forward.type'>json</entry>
  <entry key='event.forward.url'>http://127.0.0.1:8183/event</entry>
</properties>
