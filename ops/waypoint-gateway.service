[Unit]
Description=Waypoint GPS gateway to Vercel
After=network-online.target traccar.service
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/waypoint
EnvironmentFile=/opt/waypoint/server/private/gateway-agent.env
ExecStart=/opt/node/bin/node --max-old-space-size=96 /opt/waypoint/server/gateway-agent.mjs
Restart=always
RestartSec=10
MemoryMax=160M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
