{
  "name": "waypoint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "gps": "node --env-file-if-exists=server/private/gateway.env --env-file-if-exists=.env server/tracking.mjs",
    "gateway:up": "docker compose -f compose.gps.yml up -d",
    "gateway:setup": "node scripts/setup-gateway.mjs",
    "test:gateway": "node --env-file=server/private/gateway.env scripts/gateway-smoke.mjs",
    "start": "npm run gps",
    "test:gps": "node --test server/tracking.test.mjs",
    "test": "node --test server/*.test.mjs",
    "build": "tsc && vite build",
    "api": "node --env-file=.env server/sandbox.mjs",
    "test:api": "node --test server/sandbox.test.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
