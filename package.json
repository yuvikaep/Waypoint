{
  "name": "waypoint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "gps": "node --env-file-if-exists=server/private/gateway.env --env-file-if-exists=.env server/tracking.mjs",
    "gateway:up": "docker compose -f compose.gps.yml up -d",
    "gateway:setup": "node scripts/setup-gateway.mjs",
    "test:gateway": "node --env-file=server/private/gateway.env scripts/gateway-smoke.mjs",
    "test:cloud": "node --env-file=server/private/cloud-gateway.env scripts/cloud-check.mjs",
    "start": "npm run gps",
    "test:gps": "node --test server/tracking.test.mjs",
    "test": "node --test server/*.test.mjs",
    "build": "tsc && vite build",
    "api": "node --env-file=.env server/sandbox.mjs",
    "test:api": "node --test server/sandbox.test.mjs",
    "build:app": "tsc && vite build --mode app",
    "android:sync": "npm run build:app && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "@maplibre/maplibre-gl-leaflet": "^0.1.3",
    "@vercel/blob": "^2.8.2",
    "leaflet": "^1.9.4",
    "lucide": "^0.468.0",
    "maplibre-gl": "^5.6.2",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/leaflet": "^1.9.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
